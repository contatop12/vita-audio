{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "destination": "/aparelho-auditivo",
      "permanent": true
    },
    {
      "source": "/obrigado",
      "destination": "/aparelho-auditivo/obrigado",
      "permanent": false
    },
    {
      "source": "/aparelho-auditivo/",
      "destination": "/aparelho-auditivo",
      "permanent": true
    },
    {
      "source": "/audiometria/",
      "destination": "/audiometria",
      "permanent": true
    },
    {
      "source": "/zumbido-no-ouvido/",
      "destination": "/zumbido-no-ouvido",
      "permanent": true
    },
    {
      "source": "/perda-auditiva/",
      "destination": "/perda-auditiva",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/aparelho-auditivo/favicon.png",
      "destination": "/favicon.png"
    },
    {
      "source": "/aparelho-auditivo/apple-touch-icon.png",
      "destination": "/apple-touch-icon.png"
    },
    {
      "source": "/aparelho-auditivo/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/aparelho-auditivo/images/:path*",
      "destination": "/images/:path*"
    },
    {
      "source": "/aparelho-auditivo/obrigado",
      "destination": "/index.html"
    },
    {
      "source": "/aparelho-auditivo",
      "destination": "/index.html"
    },
    {
      "source": "/audiometria/obrigado",
      "destination": "/index.html"
    },
    {
      "source": "/audiometria",
      "destination": "/index.html"
    },
    {
      "source": "/zumbido-no-ouvido/obrigado",
      "destination": "/index.html"
    },
    {
      "source": "/zumbido-no-ouvido",
      "destination": "/index.html"
    },
    {
      "source": "/perda-auditiva/obrigado",
      "destination": "/index.html"
    },
    {
      "source": "/perda-auditiva",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ]
}
